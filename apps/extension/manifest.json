{
  "manifest_version": 3,
  "name": "Grafz Memory",
  "version": "1.0.0",
  "description": "Instantly save any text to your personal AI memory layer.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*.grafz.ai/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Grafz"
  },
  "background": {
    "service_worker": "background.js"
  }
}
